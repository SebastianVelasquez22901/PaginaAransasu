# Copia este archivo como .env.local para desarrollo local
# En producción, configura estas variables en Netlify → Site settings → Environment variables

# Contraseña del panel de edición (la que usará la psicóloga)
VITE_ADMIN_PASSWORD=tu-contraseña-aqui
ADMIN_PASSWORD=tu-contraseña-aqui

# Token de GitHub con permisos de escritura al repositorio
# Crear en: GitHub → Settings → Developer settings → Personal access tokens → Fine-grained tokens
# Permisos necesarios: Contents (read and write)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxx

# Repositorio en formato "usuario/nombre-repo"
GITHUB_REPO=tu-usuario/proyecto-psicologia

# Rama principal (por defecto main)
GITHUB_BRANCH=main
